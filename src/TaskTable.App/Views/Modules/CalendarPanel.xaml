<UserControl x:Class="TaskTable.App.Views.Modules.CalendarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskTable.App.ViewModels">
    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 月份导航 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Style="{StaticResource IconButton}" Command="{Binding PrevMonthCommand}" ToolTip="上一月">
                <TextBlock Text="‹" FontSize="18" Margin="0,-3,0,0"/>
            </Button>
            <TextBlock Text="{Binding MonthTitle}" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="4,0" MinWidth="104" TextAlignment="Center"/>
            <Button Style="{StaticResource IconButton}" Command="{Binding NextMonthCommand}" ToolTip="下一月">
                <TextBlock Text="›" FontSize="18" Margin="0,-3,0,0"/>
            </Button>
            <Button Style="{StaticResource GhostButton}" MinHeight="26" Padding="12,2" Margin="10,0,0,0"
                    FontSize="12" Content="今天" Command="{Binding GoTodayCommand}"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,6">
            <TextBlock Text="一" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
            <TextBlock Text="二" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
            <TextBlock Text="三" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
            <TextBlock Text="四" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
            <TextBlock Text="五" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
            <TextBlock Text="六" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
            <TextBlock Text="日" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
        </UniformGrid>

        <ListBox x:Name="CalendarGrid" Grid.Row="2"
                 ItemsSource="{Binding Cells}"
                 SelectedItem="{Binding SelectedCell, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 MouseDoubleClick="CalendarGrid_MouseDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="6"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DayCellViewModel}">
                    <Grid Cursor="Hand">
                        <Border x:Name="cell" Margin="4" CornerRadius="{StaticResource RadiusControl}"
                                Background="{Binding FillBrush}"
                                BorderBrush="#17171717" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="dayNum" Text="{Binding DayNumber}" Margin="10,7" FontSize="13"
                                           FontWeight="Medium" VerticalAlignment="Top" HorizontalAlignment="Left"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="dayTime" Text="{Binding TimeText}" Margin="0,0,8,6" FontSize="10"
                                           VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Visibility="{Binding HasTime, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                        <!-- 今天：描边环 -->
                        <Border x:Name="todayRing" Margin="4" CornerRadius="{StaticResource RadiusControl}"
                                BorderBrush="{StaticResource BrandTextBrush}" BorderThickness="2"
                                Visibility="Collapsed" IsHitTestVisible="False"/>
                        <!-- 选中：品牌绿描边 -->
                        <Border x:Name="selRing" Margin="4" CornerRadius="{StaticResource RadiusControl}"
                                BorderBrush="{StaticResource BrandBrush}" BorderThickness="2"
                                Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding UseLightText}" Value="True">
                            <Setter TargetName="dayNum" Property="Foreground" Value="#FFFFFF"/>
                            <Setter TargetName="dayTime" Property="Foreground" Value="#FFFFFF"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                            <Setter TargetName="cell" Property="Opacity" Value="0.45"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter TargetName="todayRing" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                     Value="True">
                            <Setter TargetName="selRing" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>