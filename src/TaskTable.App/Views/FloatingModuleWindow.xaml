<Window x:Class="TaskTable.App.Views.FloatingModuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务表浮窗" Width="420" Height="480"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        WindowStartupLocation="Manual" MinWidth="240" MinHeight="190">
    <Border CornerRadius="{StaticResource RadiusCard}" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：拖动移动；拖到主窗口模块上=吸回停靠；图钉=置顶 -->
            <Grid x:Name="Header" Height="34" Background="Transparent" Margin="2,0,2,0"
                  Cursor="SizeAll"
                  ToolTip="拖动标题栏移动；拖到主窗口模块卡片上＝吸回停靠；点击图钉按钮＝置顶"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  MouseMove="Header_MouseMove"
                  MouseLeftButtonUp="Header_MouseLeftButtonUp"
                  LostMouseCapture="Header_LostMouseCapture">
                <ToolTipService.ShowDuration>8000</ToolTipService.ShowDuration>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <UniformGrid Rows="3" Columns="2" Width="8" Height="12" Margin="12,0,8,0"
                             VerticalAlignment="Center">
                    <Ellipse Width="2.4" Height="2.4" Fill="{StaticResource TextMutedBrush}" Opacity="0.55"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Width="2.4" Height="2.4" Fill="{StaticResource TextMutedBrush}" Opacity="0.55"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Width="2.4" Height="2.4" Fill="{StaticResource TextMutedBrush}" Opacity="0.55"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Width="2.4" Height="2.4" Fill="{StaticResource TextMutedBrush}" Opacity="0.55"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Width="2.4" Height="2.4" Fill="{StaticResource TextMutedBrush}" Opacity="0.55"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Width="2.4" Height="2.4" Fill="{StaticResource TextMutedBrush}" Opacity="0.55"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </UniformGrid>

                <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>

                <Button x:Name="PinButton" Grid.Column="2" Width="28" Height="26" Margin="0,0,4,0"
                        Style="{StaticResource IconButton}" ToolTip="置顶显示"
                        AutomationProperties.Name="浮窗置顶" Click="Pin_Click">
                    <Path x:Name="PinPath" Width="13" Height="13" Stretch="Uniform"
                          Data="M5.5,1 H7.5 V2 L9.8,4.2 V5.6 H7.45 V10 L6.5,12.4 L5.55,10 V5.6 H3.2 V4.2 L5.5,2 Z"
                          Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Fill="Transparent"/>
                </Button>
            </Grid>

            <!-- 模块内容 -->
            <ContentControl x:Name="ModuleHost" Grid.Row="1"/>
        </Grid>
    </Border>
</Window>