<Window x:Class="TaskTable.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False">
    <Border CornerRadius="{StaticResource RadiusCard}" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <StackPanel Margin="18,14,18,18">

            <!-- 标题栏 -->
            <Grid x:Name="TitleBar" Background="Transparent" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="关闭">
                    <Image Source="pack://application:,,,/Assets/Icons/close.png" Width="13" Height="13"/>
                </Button>
            </Grid>

            <!-- ═══ 番茄钟 ═══ -->
            <TextBlock Text="番茄钟" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}"/>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="14" Margin="0,6,0,0">
                <StackPanel>
                    <CheckBox Style="{StaticResource LabeledCheckBox}" Content="启用番茄钟"
                              IsChecked="{Binding PomodoroEnabled}"/>
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="专注时长" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox Width="64" Style="{StaticResource InputBox}"
                                     Text="{Binding PomodoroWorkText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="分钟" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="休息时长" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox Width="64" Style="{StaticResource InputBox}"
                                     Text="{Binding PomodoroBreakText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="分钟" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox Style="{StaticResource LabeledCheckBox}" Content="专注结束后自动开始休息"
                              Margin="0,12,0,0" IsChecked="{Binding PomodoroAutoStartBreak}"/>

                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="任务联动" VerticalAlignment="Center"/>
                        <ListBox x:Name="LinkModeList" AutomationProperties.Name="任务联动"
                                 AutomationProperties.AutomationId="sel-linkmode"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 SelectedIndex="{Binding PomodoroLinkIndex, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SegmentedItem}"/>
                            </ListBox.ItemContainerStyle>
                            <ListBoxItem Content="关闭" AutomationProperties.AutomationId="link-off"/>
                            <ListBoxItem Content="仅启动" AutomationProperties.AutomationId="link-start"/>
                            <ListBoxItem Content="启动和停止" AutomationProperties.AutomationId="link-stop"/>
                            <ListBoxItem Content="完整联动" AutomationProperties.AutomationId="link-full"/>
                        </ListBox>
                    </Grid>
                    <TextBlock Text="{Binding PomodoroLinkHint}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ═══ 健康提醒 ═══ -->
            <TextBlock Text="健康提醒" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,16,0,0"/>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="14" Margin="0,6,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Style="{StaticResource LabeledCheckBox}" Content="久坐提醒" MinWidth="96"
                                  IsChecked="{Binding SedentaryEnabled}"/>
                        <TextBlock Text="每隔" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Width="56" Style="{StaticResource InputBox}"
                                 Text="{Binding SedentaryMinutesText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="分钟提醒一次" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox Style="{StaticResource LabeledCheckBox}" Content="喝水提醒" MinWidth="96"
                                  IsChecked="{Binding WaterEnabled}"/>
                        <TextBlock Text="每隔" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Width="56" Style="{StaticResource InputBox}"
                                 Text="{Binding WaterMinutesText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="分钟提醒一次" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ 系统 ═══ -->
            <TextBlock Text="系统" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,16,0,0"/>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="14" Margin="0,6,0,0">
                <StackPanel>
                    <CheckBox Style="{StaticResource LabeledCheckBox}" Content="开机自启动（静默进托盘）"
                              IsChecked="{Binding AutostartEnabled}"/>
                    <CheckBox Style="{StaticResource LabeledCheckBox}" Content="显示悬停提示"
                              Margin="0,12,0,0" IsChecked="{Binding ShowTooltips}"
                              AutomationProperties.Name="显示悬停提示"
                              AutomationProperties.AutomationId="chk-tooltips"/>
                    <TextBlock Text="开启后，鼠标悬停在按钮等控件上会显示功能说明气泡" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="30,5,0,0"
                               TextWrapping="Wrap"/>
                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="AI 收件箱目录" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GhostButton}" MinHeight="30" Padding="12,2" FontSize="12"
                                HorizontalAlignment="Right" Content="打开目录" Click="OpenInbox_Click"/>
                    </Grid>
                    <TextBlock Text="{Binding InboxPath}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ═══ 关于软件 ═══ -->
            <TextBlock Text="关于软件" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,16,0,0"/>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="14" Margin="0,6,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="版本号" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding AppVersionText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="Medium"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="作者" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding AuthorText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="Medium"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="使用教程" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding TutorialText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" MouseLeftButtonUp="Tutorial_Click">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}"/>
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTutorialUrl}" Value="False">
                                            <Setter Property="Cursor" Value="Arrow"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource GhostButton}" Content="取消" Margin="0,0,10,0"
                        Command="{Binding CancelCommand}"/>
                <Button Style="{StaticResource PrimaryButton}" Content="保存" IsDefault="True"
                        AutomationProperties.AutomationId="btn-save"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>