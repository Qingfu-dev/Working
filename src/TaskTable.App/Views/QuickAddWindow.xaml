<Window x:Class="TaskTable.App.Views.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速添加任务" Width="420" SizeToContent="Height"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False">
    <Border CornerRadius="{StaticResource RadiusCard}" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="18,14,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Margin="0,0,0,12" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="快速添加任务" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="关闭">
                    <Image Source="pack://application:,,,/Assets/Icons/close.png" Width="13" Height="13"/>
                </Button>
            </Grid>

            <TextBox Grid.Row="1" x:Name="TitleBox" Style="{StaticResource InputBox}"
                     Tag="任务标题（必填）"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="计划日期" FontSize="11" Margin="2,0,0,4"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="优先级" FontSize="11" Margin="12,0,0,4"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource InputBox}"
                         Tag="yyyy-MM-dd" ToolTip="计划日期（yyyy-MM-dd）"
                         Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <RadioButton x:Name="PrioHigh" GroupName="Prio" Tag="0" Content="高"
                                 Style="{StaticResource PrioRadio}" Checked="Prio_Checked"/>
                    <RadioButton x:Name="PrioMid" GroupName="Prio" Tag="1" Content="中" IsChecked="True"
                                 Style="{StaticResource PrioRadio}" Checked="Prio_Checked" Margin="6,0"/>
                    <RadioButton x:Name="PrioLow" GroupName="Prio" Tag="2" Content="低"
                                 Style="{StaticResource PrioRadio}" Checked="Prio_Checked"/>
                </StackPanel>
            </Grid>

            <TextBox Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource InputBox}"
                     Tag="标签（逗号分隔，可空）" ToolTip="标签（逗号分隔，可空）"
                     Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBox Grid.Row="4" Margin="0,10,0,0" Style="{StaticResource InputBox}" MinHeight="64"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     Tag="备注（可空）" ToolTip="备注（可空）"
                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>

            <Grid Grid.Row="6" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="取消"
                        Margin="0,0,10,0" Command="{Binding CancelCommand}"/>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="添加任务"
                        IsDefault="True" Command="{Binding SaveCommand}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
